PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/net_centric_app
# Required: generate a unique random value of at least 32 characters; never commit the real value.
JWT_SECRET=replace_with_a_unique_random_secret_of_at_least_32_characters
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Cloudinary (required for production on Vercel — no local disk storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Production CORS (set to your deployed frontend Vercel URL)
FRONTEND_URL=https://your-frontend.vercel.app
